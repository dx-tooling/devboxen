# devboxen-web with automatic HTTPS (TLS mode "auto", docs/web.md): Caddy gets a Let's
# Encrypt certificate for the domain (ports 80 and 443 of this host must be reachable, and
# the domain must point here) and passes everything to the front. WebSockets and long
# streams (terminals, VS Code) pass through as they are.
#
# The ports the boxes expose (devbox-expose) are names under the domain,
# <port>--<box>--<host>.<domain> (a wildcard DNS record *.<domain> must point here too).
# Their certificates are got on demand, at the first request for a name, and only for a
# port that is exposed: the front answers Caddy's question (its ask listener, :7701).
{
	on_demand_tls {
		ask http://devboxen-web:7701/tls-ask
	}
}

(front) {
	reverse_proxy devboxen-web:8080 {
		# The browser's address, for the front's failed-login throttling.
		header_up X-Real-Ip {remote_host}
		flush_interval -1
	}
}

{$DEVBOXEN_WEB_DOMAIN} {
	import front
}

*.{$DEVBOXEN_WEB_DOMAIN} {
	tls {
		on_demand
	}
	import front
}
