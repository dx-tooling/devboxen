#!/usr/sbin/nft -f
#
# Host firewall of a devboxen host: ONLY these two tables, never `flush ruleset` (that would
# also wipe the rules Docker keeps in nftables via iptables-nft). Loaded by
# host-firewall.service, followed by /etc/host-firewall-hosts.nft (the devboxen hosts'
# addresses); all three are installed by ansible/host.yml. The box image loads this file too,
# in each box's own network namespace (box/entrypoint.sh), where the set stays empty.
#
# Each table is first created if missing, then deleted, then defined afresh: that makes a
# reload idempotent.
table inet host_firewall
delete table inet host_firewall
table bridge host_firewall
delete table bridge host_firewall

table inet host_firewall {
    # CVE-2026-98432 (Linux IPv4 TCP use-after-free in ip_options_build(), remote root),
    # until the host runs a fixed kernel (see docs/security.md):
    #
    # - The bug is reached through a SYN that carries IPv4 options. Legitimate traffic
    #   practically never carries any, so all IPv4 TCP with options (header longer than
    #   5 words) is dropped before anything else sees it. Priority raw runs before Docker's
    #   DNAT, so this also covers traffic forwarded to containers. IPv6 is not affected.
    # - The published exploit needs an MPTCP listener. None faces the internet, but
    #   container services do on the Docker networks (Go >= 1.24 listens with MPTCP by
    #   default). TCP carrying the MPTCP option is dropped when it comes from a Docker
    #   network; a listener then only ever sees plain TCP.
    chain cve_2026_98432 {
        type filter hook prerouting priority raw; policy accept;
        ip hdrlength != 5 meta l4proto tcp counter drop
        iifname "docker0" tcp option mptcp exists counter drop
        iifname "br-*" tcp option mptcp exists counter drop
        iifname "dbx-*" tcp option mptcp exists counter drop # the devboxes' Docker bridges
    }

    # The devboxes (box/) must not reach the host's sshd, on any of the host's addresses:
    # nothing running in a box may ever log in as root on the host. Each box's network is
    # the bridge dbx-<name> (fixed names, see box/docker-compose.yaml); nested containers'
    # traffic leaves a box through it too.
    # (This file is also loaded inside each box, where no such bridge exists.)
    chain devbox_no_host_ssh {
        type filter hook input priority filter; policy accept;
        iifname "dbx-*" tcp dport 22 counter reject with tcp reset
    }

    # The same through the public addresses of all devboxen hosts (filled in by
    # /etc/host-firewall-hosts.nft). On EC2 the Elastic IP is on none of the host's
    # interfaces (it lives at the Internet Gateway), so a box's connection to it is forwarded,
    # leaves the host and comes back in from outside: the input chain above never sees it
    # as coming from a box. Also keeps the boxes of one host away from another host's sshd.
    set devboxen_hosts {
        type ipv4_addr
    }
    chain devbox_no_devbox_host_ssh {
        type filter hook forward priority filter; policy accept;
        iifname "dbx-*" ip daddr @devboxen_hosts tcp dport 22 counter reject with tcp reset
    }
}

# The same CVE-2026-98432 filter for traffic between containers on the same Docker bridge,
# which is switched, not routed. It never passes the inet table above unless br_netfilter
# hands it over, so it is filtered here as well. (Every bridge on this host is Docker's.)
#
# Not covered by any firewall: traffic inside one container's own network namespace (its
# loopback). That gap only closes with the fixed kernel.
table bridge host_firewall {
    chain cve_2026_98432 {
        type filter hook prerouting priority filter; policy accept;
        ether type ip ip hdrlength != 5 meta l4proto tcp counter drop
        ether type ip tcp option mptcp exists counter drop
    }
}
